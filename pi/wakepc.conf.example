# Copy to /etc/wakepc.conf, then: sudo chown wakepc:wakepc /etc/wakepc.conf && sudo chmod 600 /etc/wakepc.conf
[wakepc]
# Callers are identified by asking tailscaled who owns the address the request
# came from (`tailscale whois`). WireGuard has already proved that address, so
# a device on your tailnet needs no credential and you have nothing to type.
trust_tailnet = yes

# Which tailnet accounts may call. Empty means any device in this tailnet,
# which is what you want unless the tailnet is shared with other people.
# allow_users = you@example.com

# Only needed if this host has no tailscale CLI, or trust_tailnet is off.
# Generate one: python3 wakepc.py genpass 5  -> maple-otter-comet-birch-flint
# token =

# The confirmation code for commands marked `confirm` below. Set it to the
# long code you use in the app, so the relay checks it as well and the gate
# is not just the app being polite. Leave unset to let the app be the only gate.
# confirm_code = 000000

# "auto" binds to this host's Tailscale address, so nothing off the tailnet can
# even open a connection. Set an address explicitly to override.
bind_host = auto
port = 8787

# Each [command:<name>] becomes a button the app can invoke — by name only,
# the phone can never send shell. Two run kinds:
#   run = WOL <mac>        broadcast a wake-on-lan magic packet
#   run = shell <cmdline>  run a shell command as the wakepc user
# Optional per command:
#   ping = <ip>            lets the app show awake/asleep for this command
#   broadcast_ip = <ip>    WOL only; default 255.255.255.255
#   confirm = yes|no       require the confirmation code. Defaults to yes for
#                          anything that looks like it interrupts a running
#                          machine; set it by hand for commands whose name
#                          does not give them away.

[command:wake-pc]
run = WOL AA:BB:CC:DD:EE:FF
ping = 192.168.1.50
broadcast_ip = 192.168.1.255

# Shell commands run as the unprivileged wakepc user. For privileged ones,
# add a sudoers rule, e.g. in /etc/sudoers.d/wakepc:
#   wakepc ALL=(root) NOPASSWD: /usr/sbin/reboot
[command:reboot-pi]
run = shell sudo /usr/sbin/reboot
